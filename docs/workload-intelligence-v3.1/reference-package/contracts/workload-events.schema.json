{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workload-events",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_uuid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node_id",
        "gpu_uuid",
        "member_id",
        "group_id"
      ],
      "additionalProperties": false
    },
    "from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "actor_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "message": {
            "type": "string",
            "maxLength": 2048
          },
          "evidence": {
            "type": "string",
            "maxLength": 2048
          },
          "correlation_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "occurred_at",
          "event_type",
          "resource_id",
          "actor_id",
          "result",
          "message",
          "evidence",
          "correlation_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED",
        "NO_DATA",
        "DEFERRED"
      ]
    }
  },
  "required": [
    "schema_version",
    "scope",
    "from",
    "to",
    "items",
    "next_cursor",
    "capability"
  ],
  "additionalProperties": false
}
