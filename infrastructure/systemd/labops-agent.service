[Unit]
Description=LabOps Workstation Node Agent
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=aiot-ws1
Group=aiot-ws1
# Cấp quyền truy cập Docker Unix socket cho Node Agent để điều phối container workspace
SupplementaryGroups=docker

WorkingDirectory=/var/lib/labops-agent
Environment=HOME=/var/lib/labops-agent
Environment=LABOPS_WORKSPACE_REGISTRY_PATH=/var/lib/labops/workspace_registry.json
Environment=LABOPS_WORKSPACE_RUNTIME_DIR=/var/lib/labops-agent/runtime
Environment=LABOPS_REPO_GUARD_DATA_DIR=/var/lib/labops/repositoryguard
Environment=TRIVY_CACHE_DIR=/var/lib/labops-agent/trivy-cache
Environment=TRIVY_MODULE_DIR=/var/lib/labops-agent/trivy-modules
Environment=XDG_CACHE_HOME=/var/lib/labops-agent/.cache
Environment=LABOPS_REPO_PERMISSIVE_MODE=true
EnvironmentFile=/etc/labops/agent.env
ExecStart=/usr/local/bin/labops-agent

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
AmbientCapabilities=CAP_CHOWN CAP_FOWNER CAP_KILL CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_KILL CAP_SYS_PTRACE
# Dùng ProtectSystem=full (chỉ read-only /usr, /boot, /efi, /etc) thay vì strict để giữ nguyên trạng thái rw thực tế của các ổ đĩa dữ liệu (/mnt/*, /media/*) và /var/lib/*.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
