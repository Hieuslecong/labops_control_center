# ============================================================================
# LabOps Control Center V2 - Environment Configuration Template (.env.example)
# Tuyệt đối không dùng mật khẩu mặc định yếu hoặc commit tệp .env thật vào Git.
# ============================================================================

# 1. Chế độ vận hành (production | demo)
LABOPS_MODE=production
LABOPS_ALLOW_MOCK_DATA=false
NEXT_PUBLIC_DEMO_MODE=false
LABOPS_LOCAL_HOST_ID=workstation

# 2. Xác thực Người dùng (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard/overview
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard/overview

# 3. Khóa Bí mật Nội bộ giữa BFF Next.js <-> FastAPI <-> Node Agent (tối thiểu 32 bytes ngẫu nhiên)
LABOPS_SESSION_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET
LABOPS_ADMIN_API_TOKEN=REPLACE_WITH_32_BYTE_ADMIN_TOKEN
LABOPS_NODE_AGENT_TOKEN=REPLACE_WITH_32_BYTE_AGENT_TOKEN

# 4. Cơ sở dữ liệu PostgreSQL 16
POSTGRES_USER=labops
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=labops_db
DATABASE_URL=postgresql+asyncpg://labops:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:5432/labops_db

# 5. Kết nối BFF & CORS
LABOPS_BACKEND_URL=http://127.0.0.1:8000
LABOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BIND_ADDR=127.0.0.1

# 6. Tích hợp Arcane Docker Management (Admin Only - ghim v1.1.0)
ARCANE_BASE_URL=
ARCANE_API_KEY=

# 7. Tích hợp Beszel Infrastructure Monitoring (ghim v0.9.1)
BESZEL_HUB_URL=
BESZEL_API_TOKEN=

# 8. Cấu hình WireGuard VPN (JSON định nghĩa endpoint wg0 công khai)
WIREGUARD_SERVERS_JSON=
