# Pin the Teleport Community packages and agents to 18.11.8 (current 18.x patch as of 2026-11-04).
# Replace every 192.0.2.0/24 example address and hostname after the private
# Gateway/VPN and DNS/TLS plan has been verified. This file is not production-ready.
version: v3

teleport:
  nodename: labops-teleport-hub
  data_dir: /var/lib/teleport
  log:
    output: stderr
    severity: INFO

auth_service:
  enabled: "yes"
  listen_addr: 127.0.0.1:3025
  cluster_name: teleport.vpn.example.org
  authentication:
    type: local
    second_factor: "on"
    second_factors:
      - webauthn
    webauthn:
      rp_id: teleport.vpn.example.org

proxy_service:
  enabled: "yes"
  web_listen_addr: 192.0.2.10:443
  tunnel_listen_addr: 192.0.2.10:3024
  public_addr: teleport.vpn.example.org:443
  auth_servers:
    - 127.0.0.1:3025
  https_keypairs:
    - key_file: /etc/teleport/tls/proxy.key
      cert_file: /etc/teleport/tls/proxy.crt

ssh_service:
  enabled: "no"
