# Cấu hình biến môi trường cho LabOps Go Node Agent
LABOPS_SERVER_ID="track"
LABOPS_SERVER_NAME="Server 01 — Server Rack (aiotlab-rack • Cục bộ)"
LABOPS_AGENT_BIND_ADDR="127.0.0.1"
LABOPS_AGENT_PORT="9100"
LABOPS_AGENT_SECRET="labops-local-agent-verified-token-2026"
DOCKER_HOST="/var/run/docker.sock"

# Cấu hình kết nối Zero-Trust mTLS gRPC Gateway (Bảo mật Đa Node)
LABOPS_GATEWAY_ENABLED="true"
LABOPS_GATEWAY_URL="192.168.167.250:9443"
LABOPS_GATEWAY_CA_PATH="/etc/labops/certs/ca.crt"
LABOPS_GATEWAY_CERT_PATH="/etc/labops/certs/client.crt"
LABOPS_GATEWAY_KEY_PATH="/etc/labops/certs/client.key"
LABOPS_GATEWAY_SERVER_NAME="gateway.control-plane.labops.local"


