[Unit]
Description=LabOps Zero-Trust Agent Gateway (mTLS TLS 1.3 gRPC Streaming Hub)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=aiot-1
Group=aiot-1
WorkingDirectory=/home/aiot-1/admin_labops_control_center
ExecStart=/home/aiot-1/admin_labops_control_center/bin/labops-gateway
Restart=always
RestartSec=3

Environment=LABOPS_GATEWAY_GRPC_PORT=9443
Environment=LABOPS_GATEWAY_HTTP_PORT=9444
Environment=LABOPS_GATEWAY_BIND_ADDR=0.0.0.0
Environment=LABOPS_GATEWAY_HTTP_BIND=0.0.0.0
Environment=LABOPS_GATEWAY_PKI_DIR=/home/aiot-1/.labops/pki

# Bảo mật Systemd Sandbox
LimitNOFILE=65536
ProtectSystem=full
NoNewPrivileges=true
ReadWritePaths=/home/aiot-1/.labops /home/aiot-1/admin_labops_control_center

[Install]
WantedBy=multi-user.target

