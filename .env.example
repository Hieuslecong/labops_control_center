# ========================================================
# LabOps Control Center — AI Research Infrastructure Config
# ========================================================

# --------------------------------------------------------
# 1. Frontend Configuration (Next.js)
# --------------------------------------------------------
# Clerk Authentication (optional in Demo Mode, fallback to Local Admin)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample
CLERK_SECRET_KEY=sk_test_sample

# Mode: true for Demo Mode (Zustand mock state), false for Production Mode (FastAPI)
NEXT_PUBLIC_DEMO_MODE=true

# FastAPI Backend Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --------------------------------------------------------
# 2. Backend Configuration (FastAPI)
# --------------------------------------------------------
PROJECT_NAME="LabOps Control Center API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEMO_MODE=true

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://labops:labops_secret@localhost:5432/labops_db
POSTGRES_USER=labops
POSTGRES_PASSWORD=labops_secret
POSTGRES_DB=labops_db

# --------------------------------------------------------
# 3. Physical Server & Cluster Adapters
# --------------------------------------------------------
# Server 01 — Track (Hà Nội, 3x NVIDIA A30 24GB)
TRACK_SERVER_URL=https://10.10.1.10:8443
NETDATA_TRACK_URL=http://10.200.0.1:19999
TRACK_INCUS_CERT_PATH=/etc/labops/certs/track-client.crt
TRACK_INCUS_KEY_PATH=/etc/labops/certs/track-client.key

# Server 02 — Workstation (TP.HCM, 1x NVIDIA A30 24GB)
WORKSTATION_SERVER_URL=https://10.10.2.20:8443
NETDATA_WS_URL=http://10.200.0.2:19999
WS_INCUS_CERT_PATH=/etc/labops/certs/ws-client.crt
WS_INCUS_KEY_PATH=/etc/labops/certs/ws-client.key

# WireGuard Mesh Interface
WIREGUARD_INTERFACE=wg0

# Security Review Sandbox
SECURITY_SANDBOX_WORKER_CONCURRENCY=2
MAX_CONCURRENT_AST_SCANS=4

