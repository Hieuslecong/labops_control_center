# ============================================================================
# LabOps Control Center - Workstation Primary Deployment Configuration Template
# File: .env.workstation.example
# ============================================================================

# 1. Host Identification & Mode
LABOPS_MODE=production
LABOPS_ALLOW_MOCK_DATA=false
NEXT_PUBLIC_DEMO_MODE=false
LABOPS_LOCAL_HOST_ID=workstation
LABOPS_SERVER_ID=workstation
LABOPS_SERVER_NAME="Workstation 01 (aiot-ws1 • Cục bộ • 1x NVIDIA A30)"

# 2. Local Networking & Binding (Loopback Only for Initial Deployment)
LABOPS_BACKEND_URL=http://127.0.0.1:8000
LABOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_BIND_ADDR=127.0.0.1
PORT=3000

# 3. Security Tokens (Generate using: openssl rand -hex 32)
LABOPS_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
LABOPS_ADMIN_API_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
LABOPS_NODE_AGENT_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# 4. Web Admin Credentials (Used when Clerk is not configured)
LABOPS_ADMIN_USERNAME=admin
LABOPS_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# 5. Node Agent Configuration
LABOPS_AGENT_BIND_ADDR=127.0.0.1
LABOPS_AGENT_PORT=9100
LABOPS_AGENT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
LABOPS_GATEWAY_ENABLED=false

# 6. 9Router AI Gateway Configuration
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_MODEL=model_free
ROUTER_API_KEY=

# 7. Zalo AI Assistant & Quota
ZALO_BOT_TOKEN=
ZALO_AUTHORIZED_USERS=*
ZALO_MONTHLY_LIMIT=3000
ZALO_STANDARD_LIMIT=2800
ZALO_CRITICAL_RESERVE=200

# 8. Database (Mặc định: SQLite WAL; Bỏ comment khi kích hoạt PostgreSQL ngoài)
DATABASE_URL=sqlite:///backend/data/labops_v2.sqlite3
# DATABASE_URL=postgresql+asyncpg://labops:CHANGE_PASSWORD@127.0.0.1:5432/labops_db

# 9. WireGuard VPN Gateway (wg-easy v15)
WG_EASY_ADMIN_USER=admin
WG_EASY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_WG_EASY_PASSWORD
WG_EASY_PUBLIC_ENDPOINT=118.70.169.236:2204
WG_EASY_UDP_PORT=2204
WG_EASY_VPN_SUBNET=10.88.40.0/24
# LABOPS_WG_SERVER_PUBLIC_KEY: không cần đặt; đọc từ wg-easy runtime
