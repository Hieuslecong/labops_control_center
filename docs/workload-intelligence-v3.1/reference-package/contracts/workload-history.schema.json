{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workload-history",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "node_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_uuid": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node_id",
        "gpu_uuid",
        "member_id",
        "group_id"
      ],
      "additionalProperties": false
    },
    "from": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "to": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "member_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "group_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "first_seen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_seen_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "OBSERVED",
              "STALE",
              "MISSING_UNCONFIRMED",
              "EXIT_CONFIRMED",
              "UNKNOWN"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 2048
          },
          "actionable": {
            "const": false
          }
        },
        "required": [
          "id",
          "node_id",
          "member_id",
          "group_id",
          "first_seen_at",
          "last_seen_at",
          "observed_seconds",
          "state",
          "exit_code",
          "exit_reason",
          "evidence",
          "actionable"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "capability": {
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED",
        "NO_DATA",
        "DEFERRED"
      ]
    }
  },
  "required": [
    "schema_version",
    "scope",
    "from",
    "to",
    "items",
    "next_cursor",
    "capability"
  ],
  "additionalProperties": false
}
