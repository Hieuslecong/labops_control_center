# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pid

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# local env files
.env
.env*.local
!.env.example
*.env
deploy/*.env
deploy/labops-agent.env
bin/node


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# clerk configuration (can include secrets)
/.clerk/


# cursor 
.cursorrules
/memory-bank

# Sentry Config File
.env.sentry-build-plugin

# Runtime Telemetry Data & Persistent Local State (NEVER commit live PII/hashes/keys)
backend/data/*.json
backend/data/*.json.*
backend/data/*.jsonl
backend/data/*.db
backend/data/*.sqlite*
backend/data/*.journal
backend/data/*.lock
backend/data/*.tmp
backend/data/workspaces/
backend/data/backups/
!backend/data/examples/*.example.json
graphify-out/

# Client VPN and binary packages
*.conf
*.zip
bin/

*.log

# Blue-Green zero-downtime deployment artifacts
/.next-blue/
/.next-green/
/.runtime/
